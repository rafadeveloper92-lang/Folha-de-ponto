# Opcional: desativar HMR em ambientes onde o file watch causa problemas
# DISABLE_HMR=true

# URL pública (JSON) com mensagens para a caixa de entrada — ver README ou docs da equipa
# VITE_MESSAGES_JSON_URL=https://exemplo.com/gsi-mensagens.json

# Chave pública VAPID (Web Push) — gerar par com web-push / serviço de backend
# VITE_VAPID_PUBLIC_KEY=BNx...

# WhatsApp (só dígitos, sem +) para pedidos de materiais/roupa — padrão 34641672023
# VITE_SUPPLIES_WHATSAPP=34641672023
